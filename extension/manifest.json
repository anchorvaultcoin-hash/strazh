{
  "manifest_version": 3,
  "name": "STRAZH — private key guard",
  "version": "0.2.0",
  "description": "Stops a recovery phrase or a private key from leaving your browser by mistake. Works with no setup. No network access, no host permissions.",
  "permissions": ["storage"],
  "host_permissions": [],
  "options_page": "options.html",
  "action": {
    "default_title": "STRAZH",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "sha256.js",
        "keccak.js",
        "secp256k1.js",
        "bip39-wordlist.js",
        "bip39.js",
        "expectation.js",
        "detector.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
